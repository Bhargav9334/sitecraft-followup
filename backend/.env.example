# ============ Follow Up Software — backend settings ============
# Copy this file to ".env" and fill in your values.
# Set up for a normal Gmail account (e.g. sitecraft94@gmail.com).

# ---- Server ----
PORT=5001
# Frontend address (comma separated if more than one) — only these can call the API
FRONTEND_URL=http://localhost:3000
# Public address of THIS backend — used in the unsubscribe link inside every mail.
# On the live server use your real domain, e.g. https://api.yourdomain.com
PUBLIC_BACKEND_URL=http://localhost:5001
# Set true when running behind Nginx / CloudPanel reverse proxy
TRUST_PROXY=false

# ---- Login (only this ID/password can open the software) ----
ADMIN_USERNAME=bhargav
ADMIN_PASSWORD=change-this-strong-password
# Long random secret (min 32 characters). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-64-random-characters
SESSION_HOURS=12

# ---- MongoDB ----
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=myfollowup

# ---- Gmail account ----
# FROM_EMAIL, SMTP_USER and IMAP_USER = the same Gmail address.
# SMTP_PASS / IMAP_PASS = Gmail "App Password" (16 letters, no spaces) — NOT your normal Gmail password.
FROM_EMAIL=sitecraft94@gmail.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sitecraft94@gmail.com
SMTP_PASS=your16letterapppassword

IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=sitecraft94@gmail.com
IMAP_PASS=your16letterapppassword
IMAP_POLL_MINUTES=5

# ---- Sender name + signature (starting values — change anytime from Settings page) ----
FROM_NAME=Bhargav from SiteCraft
SENDER_NAME=Bhargav
SIGNATURE_CLOSING=Best regards,
SIGNATURE_NAME=SiteCraft by Bhargav
SIGNATURE_PHONE=

# ---- Sending rules ----
TIMEZONE=Asia/Kolkata
DAILY_LIMIT=30
# Hard cap — the Settings page can never go above this
MAX_DAILY_LIMIT=30
# 9 AM to 7 PM, one mail every 18 minutes (fits 30 mails in the window)
SEND_START_HOUR=9
SEND_END_HOUR=19
SEND_GAP_MINUTES=18
SKIP_SUNDAYS=true

# true = mails are only printed in the console (for testing), not really sent
MAIL_DRY_RUN=false

# ---- Sending method ----
# smtp      = Gmail SMTP with the App Password above (works on your computer / a VPS)
# gmail-api = Gmail API over HTTPS (for free hosting like Render, where SMTP ports are blocked)
# Setup: Google Cloud → enable Gmail API → OAuth client ID (Desktop app) → put id/secret here → run: npm run gmail-auth
MAIL_TRANSPORT=smtp
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
